.gacha-root {
    position: absolute;
    width: 100%;
    height: 100%;
    flex: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(20, 22, 42);
    padding: 24px;
}

.gacha-title {
    color: rgb(241, 240, 248);
    font-size: 20px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.gacha-currency-label {
    color: rgb(232, 181, 77);
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 16px;
}

.gacha-card {
    width: 140px;
    height: 190px;
    border-width: 3px;
    border-radius: 14px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.04);
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
}

.gacha-card-label {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(146, 150, 184);
}

.gacha-button-row {
    flex-direction: row;
}

.gacha-button {
    background-color: rgba(232, 181, 77, 0.14);
    color: rgb(232, 181, 77);
    border-color: rgba(232, 181, 77, 0.35);
    border-width: 1px;
    border-radius: 9px;
    padding: 10px 18px;
    font-size: 13px;
    -unity-font-style: bold;
}

.gacha-button.secondary {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(241, 240, 248);
    border-color: rgba(255, 255, 255, 0.12);
    margin-left: 8px;
}

.gacha-pity-label {
    margin-top: 12px;
    color: rgb(146, 150, 184);
    font-size: 12px;
}

.gacha-message-label {
    margin-top: 8px;
    color: rgb(248, 113, 113);
    font-size: 12px;
}

/* 등급별 색상 — "테두리/글자색"용과 "배경 채우기색"용 클래스를 서로 다른 이름으로 나눴습니다.
   같은 클래스에 color(글자색)와 background-color(배경색)를 동시에 넣으면,
   글자가 있는 라벨에서는 글자색 = 배경색이 되어 글자가 안 보이는 문제가 생기기 때문입니다.
   → 테두리/글자에는 .tier-r 같은 클래스를, 점·막대처럼 "글자 없이 색만 채우는" 곳에는
      .tier-r-fill 같은 클래스를 사용합니다. */
.tier-r {
    border-color: rgb(122, 127, 158);
    color: rgb(122, 127, 158);
}

.tier-sr {
    border-color: rgb(95, 168, 224);
    color: rgb(95, 168, 224);
}

.tier-ssr {
    border-color: rgb(169, 139, 240);
    color: rgb(169, 139, 240);
}

.tier-lr {
    border-color: rgb(232, 181, 77);
    color: rgb(232, 181, 77);
}

.tier-r-fill {
    background-color: rgb(122, 127, 158);
}

.tier-sr-fill {
    background-color: rgb(95, 168, 224);
}

.tier-ssr-fill {
    background-color: rgb(169, 139, 240);
}

.tier-lr-fill {
    background-color: rgb(232, 181, 77);
}

/* ---- 6단계: 검증 시뮬레이터 ---- */

.gacha-section-title {
    color: rgb(241, 240, 248);
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 20px;
    margin-bottom: 10px;
}

.gacha-sim-section {
    align-items: center;
}

.gacha-sim-results {
    width: 340px;
    margin-top: 12px;
}

.gacha-sim-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

/* 등급 색상을 보여주는 작은 동그란 점 (텍스트 없이 색상만 표시) */
.gacha-sim-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 6px;
    flex-shrink: 0;
}

/* 점 옆에 붙는 등급 이름(R/SR/SSR/LR) 글자 — 항상 잘 보이도록 배경과 상관없는 밝은 고정색을 씁니다 */
.gacha-sim-tier-label {
    width: 32px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(241, 240, 248);
}

/* 막대 그래프 트랙 — 그 안에 "설계값 막대"와 "실측값 막대"를 겹쳐서 보여줍니다 */
.gacha-sim-track {
    flex-grow: 1;
    height: 10px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 5px;
    margin-left: 6px;
    margin-right: 6px;
    overflow: hidden;
}

.gacha-sim-designed {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.18);
}

.gacha-sim-actual {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    opacity: 0.85;
}

.gacha-sim-text {
    width: 150px;
    font-size: 10px;
    color: rgb(146, 150, 184);
    -unity-text-align: middle-right;
}

.gacha-sim-pity-check {
    margin-top: 10px;
    font-size: 11px;
    color: rgb(74, 222, 128);
}
