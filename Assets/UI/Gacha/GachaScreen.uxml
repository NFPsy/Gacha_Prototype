<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Gacha/GachaScreen.uss" />
    <ui:VisualElement name="root" class="gacha-root">
        <ui:Label text="가챠 시스템 프로토타입" name="title" class="gacha-title" />
        <ui:Label text="보유 재화: 0" name="currency-label" class="gacha-currency-label" />
        <ui:VisualElement name="card" class="gacha-card">
            <ui:Label text="?" name="card-label" class="gacha-card-label" />
        </ui:VisualElement>
        <ui:VisualElement name="button-row" class="gacha-button-row">
            <ui:Button text="1회 뽑기" name="draw-button" class="gacha-button" />
            <ui:Button text="일일 재화 받기" name="claim-daily-button" class="gacha-button secondary" />
        </ui:VisualElement>
        <ui:Label text="천장까지 0 / 60" name="pity-label" class="gacha-pity-label" />
        <ui:Label text="" name="message-label" class="gacha-message-label" />

        <ui:VisualElement name="sim-section" class="gacha-sim-section">
            <ui:Label text="검증 시뮬레이터 (설계값 vs 실측값)" name="sim-title" class="gacha-section-title" />
            <ui:Button text="1,000회 시뮬레이션" name="simulate-button" class="gacha-button secondary" />

            <ui:VisualElement name="sim-results" class="gacha-sim-results">
                <ui:VisualElement name="sim-row-R" class="gacha-sim-row">
                    <ui:VisualElement class="gacha-sim-dot tier-r-fill" />
                    <ui:Label text="R" class="gacha-sim-tier-label" />
                    <ui:VisualElement class="gacha-sim-track">
                        <ui:VisualElement name="sim-designed-R" class="gacha-sim-designed" />
                        <ui:VisualElement name="sim-actual-R" class="gacha-sim-actual tier-r-fill" />
                    </ui:VisualElement>
                    <ui:Label name="sim-text-R" text="설계 -.-% / 실측 -.-%" class="gacha-sim-text" />
                </ui:VisualElement>
                <ui:VisualElement name="sim-row-SR" class="gacha-sim-row">
                    <ui:VisualElement class="gacha-sim-dot tier-sr-fill" />
                    <ui:Label text="SR" class="gacha-sim-tier-label" />
                    <ui:VisualElement class="gacha-sim-track">
                        <ui:VisualElement name="sim-designed-SR" class="gacha-sim-designed" />
                        <ui:VisualElement name="sim-actual-SR" class="gacha-sim-actual tier-sr-fill" />
                    </ui:VisualElement>
                    <ui:Label name="sim-text-SR" text="설계 -.-% / 실측 -.-%" class="gacha-sim-text" />
                </ui:VisualElement>
                <ui:VisualElement name="sim-row-SSR" class="gacha-sim-row">
                    <ui:VisualElement class="gacha-sim-dot tier-ssr-fill" />
                    <ui:Label text="SSR" class="gacha-sim-tier-label" />
                    <ui:VisualElement class="gacha-sim-track">
                        <ui:VisualElement name="sim-designed-SSR" class="gacha-sim-designed" />
                        <ui:VisualElement name="sim-actual-SSR" class="gacha-sim-actual tier-ssr-fill" />
                    </ui:VisualElement>
                    <ui:Label name="sim-text-SSR" text="설계 -.-% / 실측 -.-%" class="gacha-sim-text" />
                </ui:VisualElement>
                <ui:VisualElement name="sim-row-LR" class="gacha-sim-row">
                    <ui:VisualElement class="gacha-sim-dot tier-lr-fill" />
                    <ui:Label text="LR" class="gacha-sim-tier-label" />
                    <ui:VisualElement class="gacha-sim-track">
                        <ui:VisualElement name="sim-designed-LR" class="gacha-sim-designed" />
                        <ui:VisualElement name="sim-actual-LR" class="gacha-sim-actual tier-lr-fill" />
                    </ui:VisualElement>
                    <ui:Label name="sim-text-LR" text="설계 -.-% / 실측 -.-%" class="gacha-sim-text" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="" name="sim-pity-check-label" class="gacha-sim-pity-check" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
