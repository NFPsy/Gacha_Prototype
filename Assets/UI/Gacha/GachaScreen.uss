/* ==== 디자인 토큰 ====
   색상을 여기 한 곳에서만 선언하고 나머지 규칙은 var()로 참조합니다.
   (hallmark 감사 결과: 금색/흰색 텍스트가 파일 곳곳에 rgb() 리터럴로 중복돼 있던 문제 수정) */
.gacha-root {
    --color-paper: rgb(11, 9, 5);
    --color-paper-2: rgb(20, 17, 12);
    --color-paper-3: rgb(32, 28, 22);
    --color-rule: rgb(54, 50, 44);
    --color-neutral: rgb(125, 122, 116);
    --color-muted: rgb(167, 164, 159);
    --color-ink: rgb(241, 238, 234);

    --color-accent: rgb(233, 171, 43);
    --color-accent-dim: rgba(233, 171, 43, 0.16);
    --color-accent-dim-hover: rgba(233, 171, 43, 0.28);
    --color-accent-border: rgba(233, 171, 43, 0.4);
    --color-focus: rgb(253, 181, 0);

    --color-tier-r: rgb(128, 134, 147);
    --color-tier-sr: rgb(72, 161, 219);
    --color-tier-ssr: rgb(160, 130, 237);
    --color-tier-lr: rgb(233, 171, 43);

    --color-success: rgb(90, 197, 118);
    --color-danger: rgb(239, 102, 97);

    position: absolute;
    width: 100%;
    height: 100%;
    flex: 1;
    background-color: var(--color-paper);
    padding: 28px;
}

/* ==== 화면 골격: 기존 "전부 중앙정렬 세로 스택" 대신
   좌(뽑기 액션) / 우(검증 시뮬레이터) 2단 패널 구성으로 변경 ==== */
.gacha-hud {
    flex-direction: row;
    flex-grow: 1;
}

.gacha-panel {
    background-color: var(--color-paper-2);
    border-width: 1px;
    border-color: var(--color-rule);
    border-radius: 14px;
    padding: 24px;
}

.gacha-draw-panel {
    width: 400px;
    align-items: flex-start;
    margin-right: 28px;
}

.gacha-sim-section {
    flex-grow: 1;
    align-items: flex-start;
}

.gacha-title {
    color: var(--color-ink);
    font-size: 26px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

.gacha-currency-label {
    color: var(--color-accent);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 26px;
}

.gacha-card {
    width: 180px;
    height: 240px;
    border-width: 4px;
    border-radius: 16px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.04);
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
}

.gacha-card-label {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--color-neutral);
}

.gacha-button-row {
    flex-direction: row;
    margin-bottom: 26px;
}

/* ==== 버튼: 주(primary) / 보조(secondary) 위계를 명확히 분리하고
   hover / focus / active / disabled 상태를 추가 (기존엔 정적 상태 하나뿐이었음) ==== */
.gacha-button {
    background-color: var(--color-accent-dim);
    color: var(--color-accent);
    border-color: var(--color-accent-border);
    border-width: 1px;
    border-radius: 10px;
    padding: 13px 22px;
    font-size: 16px;
    -unity-font-style: bold;
    transition-property: background-color, opacity;
    transition-duration: 0.12s;
}

.gacha-button:hover {
    background-color: var(--color-accent-dim-hover);
}

.gacha-button:active {
    background-color: var(--color-accent-border);
}

.gacha-button:focus {
    border-width: 2px;
    border-color: var(--color-focus);
}

.gacha-button:disabled {
    opacity: 0.4;
}

.gacha-button.secondary {
    background-color: rgba(255, 255, 255, 0);
    color: var(--color-muted);
    border-color: rgba(255, 255, 255, 0);
    margin-left: 10px;
}

.gacha-button.secondary:hover {
    background-color: var(--color-paper-3);
    color: var(--color-ink);
}

.gacha-button.secondary:active {
    background-color: var(--color-rule);
}

.gacha-button.secondary:focus {
    border-width: 2px;
    border-color: var(--color-focus);
}

/* ==== 천장(피티) 게이지: 텍스트만 있던 것을 진행 막대로 시각화
   (시뮬레이터 섹션과 컴포넌트 언어 통일) ==== */
.gacha-pity-block {
    width: 100%;
    margin-bottom: 18px;
}

.gacha-pity-label {
    color: var(--color-muted);
    font-size: 15px;
    margin-bottom: 8px;
}

.gacha-pity-track {
    height: 9px;
    border-radius: 4px;
    background-color: var(--color-paper-3);
    overflow: hidden;
}

.gacha-pity-fill {
    height: 100%;
    background-color: var(--color-accent);
    border-radius: 4px;
}

.gacha-message-label {
    margin-top: 6px;
    color: var(--color-danger);
    font-size: 14px;
}

/* 성공/안내 메시지(예: 일일 재화 지급)는 빨간색이 아니라 초록색으로 구분 */
.gacha-message-label.gacha-message-success {
    color: var(--color-success);
}

/* 등급별 색상 — "테두리/글자색"용과 "배경 채우기색"용 클래스를 서로 다른 이름으로 나눴습니다.
   같은 클래스에 color(글자색)와 background-color(배경색)를 동시에 넣으면,
   글자가 있는 라벨에서는 글자색 = 배경색이 되어 글자가 안 보이는 문제가 생기기 때문입니다.
   → 테두리/글자에는 .tier-r 같은 클래스를, 점·막대처럼 "글자 없이 색만 채우는" 곳에는
      .tier-r-fill 같은 클래스를 사용합니다. 색상 값 자체는 위 토큰에서 한 번만 선언됩니다. */
.tier-r {
    border-color: var(--color-tier-r);
    color: var(--color-tier-r);
}

.tier-sr {
    border-color: var(--color-tier-sr);
    color: var(--color-tier-sr);
}

.tier-ssr {
    border-color: var(--color-tier-ssr);
    color: var(--color-tier-ssr);
}

.tier-lr {
    border-color: var(--color-tier-lr);
    color: var(--color-tier-lr);
}

.tier-r-fill {
    background-color: var(--color-tier-r);
}

.tier-sr-fill {
    background-color: var(--color-tier-sr);
}

.tier-ssr-fill {
    background-color: var(--color-tier-ssr);
}

.tier-lr-fill {
    background-color: var(--color-tier-lr);
}

/* ---- 6단계: 검증 시뮬레이터 ---- */

/* 실행 횟수 선택 칩 */
.gacha-chip-row {
    flex-direction: row;
    margin-bottom: 16px;
}

.gacha-chip {
    background-color: var(--color-paper-3);
    color: var(--color-muted);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0);
    border-radius: 7px;
    padding: 8px 13px;
    font-size: 13px;
    -unity-font-style: normal;
    margin-right: 7px;
}

.gacha-chip:hover {
    color: var(--color-ink);
}

.gacha-chip:focus {
    border-width: 1px;
    border-color: var(--color-focus);
}

.gacha-chip.is-active {
    background-color: var(--color-accent-dim);
    color: var(--color-accent);
    border-color: var(--color-accent-border);
}

.gacha-section-title {
    color: var(--color-ink);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 18px;
}

.gacha-sim-results {
    width: 100%;
    margin-top: 22px;
}

.gacha-sim-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 16px;
}

/* 등급 색상을 보여주는 작은 동그란 점 (텍스트 없이 색상만 표시) */
.gacha-sim-dot {
    width: 13px;
    height: 13px;
    border-radius: 7px;
    margin-right: 8px;
    flex-shrink: 0;
}

/* 점 옆에 붙는 등급 이름(R/SR/SSR/LR) 글자 — 항상 잘 보이도록 배경과 상관없는 밝은 고정색을 씁니다 */
.gacha-sim-tier-label {
    width: 40px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-ink);
}

/* 막대 그래프 트랙 — 그 안에 "설계값 막대"와 "실측값 막대"를 겹쳐서 보여줍니다 */
.gacha-sim-track {
    flex-grow: 1;
    height: 14px;
    background-color: rgba(255, 255, 255, 0.06);
    border-radius: 7px;
    margin-left: 8px;
    margin-right: 8px;
    overflow: hidden;
}

.gacha-sim-designed {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.18);
}

.gacha-sim-actual {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    opacity: 0.85;
}

.gacha-sim-text {
    width: 180px;
    font-size: 13px;
    color: var(--color-muted);
    -unity-text-align: middle-right;
}

/* 설계값 대비 편차(Δ) — 기본은 중립색, 위/아래로 벌어지면 초록/빨강으로 표시 */
.gacha-sim-delta {
    width: 56px;
    margin-left: 8px;
    font-size: 13px;
    color: var(--color-neutral);
    -unity-text-align: middle-right;
}

.gacha-sim-delta-up {
    color: var(--color-success);
}

.gacha-sim-delta-down {
    color: var(--color-danger);
}

/* 천장까지 뽑기 횟수 분포 히스토그램 */
.gacha-hist-block {
    margin-top: 32px;
    width: 100%;
}

.gacha-hist-title {
    color: var(--color-ink);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 14px;
}

/* 막대 위에 실제 카운트 숫자를 보여주는 줄. 막대와 같은 개수(12개) · 같은 flex-grow·margin을 써서
   숫자 하나하나가 바로 아래 막대와 정확히 같은 칸(열)에 오도록 맞춥니다. */
.gacha-hist-counts {
    flex-direction: row;
    height: 18px;
    width: 100%;
    margin-bottom: 3px;
}

.gacha-hist-count-label {
    flex-grow: 1;
    margin-right: 3px;
    font-size: 11px;
    color: var(--color-muted);
    -unity-text-align: lower-center;
}

.gacha-hist {
    flex-direction: row;
    align-items: flex-end;
    height: 165px;
    width: 100%;
}

.gacha-hist-bar {
    flex-grow: 1;
    margin-right: 3px;
    background-color: var(--color-accent);
    opacity: 0.8;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    min-height: 2px;
}

.gacha-hist-caption {
    margin-top: 10px;
    font-size: 12px;
    color: var(--color-muted);
    white-space: normal;
}

.gacha-sim-pity-check {
    margin-top: 16px;
    font-size: 14px;
    color: var(--color-success);
}
